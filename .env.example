# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syma_tech?schema=public"

# Authentication Secrets
ADMIN_JWT_SECRET="replace_with_a_secure_random_string"
STUDENT_JWT_SECRET="replace_with_a_secure_random_string"

# Transactional Email (Brevo)
BREVO_API_KEY="your_brevo_api_key_here"
EMAIL_FROM_EMAIL="symatechsolutions@gmail.com"
EMAIL_FROM_NAME="Syma Tech Solutions"

# Paystack Payment Gateway (TEST MODE)
# Server-only secret key used for transaction initialization, verification, and webhook HMAC SHA-512 signing
PAYSTACK_SECRET_KEY="sk_test_..."
# Canonical site origin used to build trusted Paystack callback URLs.
APP_URL="https://your-production-domain.example"
# Keep NGN only unless additional currencies are enabled for this merchant account.
PAYSTACK_SUPPORTED_CURRENCIES="NGN"

# Optional public key for frontend reference
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."

# Cloudflare R2 Resource Storage
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="syma-tech-resources"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
