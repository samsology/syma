generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  SUSPENDED
}

enum Currency {
  USD
  NGN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
}

enum EnrollmentSource {
  MANUAL
  PAYMENT
}

enum LessonType {
  TEXT
  VIDEO
  ASSIGNMENT
}

enum LessonResourceType {
  SLIDE
  VIDEO
}

enum ResourceType {
  VIDEO
  DOCUMENT
  FILE
  LINK
}

enum ResourceSource {
  YOUTUBE
  GOOGLE_DRIVE
  UPLOAD
  EXTERNAL
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  courses  Course[]       @relation("CourseInstructor")
  sessions AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  shortDescription String
  description      String
  category         String
  level            String
  duration         String
  priceMinor       Int          @default(0)
  currency         Currency     @default(USD)
  benefits         String[]     @default([])
  cta              String       @default("Enroll Now")
  sortOrder        Int          @default(0)
  thumbnailUrl     String?
  instructorId     String?
  status           CourseStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  instructor  Admin?       @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  weeks       CourseWeek[]
  enrollments Enrollment[]
  orders      Order[]

  @@index([status])
  @@index([category])
  @@index([instructorId])
  @@index([sortOrder])
}

model Student {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String        @unique
  passwordHash String
  phone        String?
  status       StudentStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions            StudentSession[]
  enrollments         Enrollment[]
  orders              Order[]
  progress              LessonProgress[]
  summaryProgress       ModuleSummaryProgress[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  applications          StudentApplication[]
  passwordResetTokens   StudentPasswordResetToken[]

  @@index([status])
  @@index([createdAt])
}

model StudentApplication {
  id                         String    @id @default(cuid())
  fullName                   String
  email                      String
  phone                      String
  program                    String
  experience                 String
  motivation                 String
  status                     String    @default("PENDING")
  registrationTokenHash      String?   @unique
  registrationTokenExpiresAt DateTime?
  registrationTokenUsedAt    DateTime?

  studentId                  String?
  student                    Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([email])
  @@index([studentId])
  @@index([registrationTokenHash])
}

model StudentSession {
  id        String   @id @default(cuid())
  studentId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([expiresAt])
}

model StudentPasswordResetToken {
  id        String    @id @default(cuid())
  studentId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model StudentLoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  courseId    String
  status      EnrollmentStatus @default(PENDING)
  source      EnrollmentSource @default(MANUAL)
  orderId     String?          @unique
  enrolledAt  DateTime         @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  studentId   String
  courseId    String
  amountMinor Int
  currency    Currency    @default(USD)
  status      OrderStatus @default(PENDING)
  expiresAt   DateTime?
  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payments   Payment[]
  enrollment Enrollment?

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  providerReference String
  authorizationUrl  String?
  amountMinor       Int
  currency          Currency        @default(USD)
  status            PaymentStatus   @default(PENDING)
  providerEventId   String?
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model CourseWeek {
  id          String   @id @default(cuid())
  courseId    String
  weekNumber  Int
  title       String
  description String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modules     CourseModule[]
  assignment  WeeklyAssignment?

  @@unique([courseId, weekNumber])
  @@index([courseId])
}

model CourseModule {
  id          String   @id @default(cuid())
  weekId      String
  title       String
  description String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  week        CourseWeek     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  summary     ModuleSummary?
  quiz        ModuleQuiz?

  @@index([weekId])
}

model Lesson {
  id           String              @id @default(cuid())
  moduleId     String
  title        String
  slug         String
  lessonType   LessonType          @default(TEXT)
  resourceType LessonResourceType? @default(VIDEO)
  slideUrl     String?
  content      String
  videoUrl     String?
  duration     Int?
  isPreview    Boolean             @default(false)
  status       CourseStatus        @default(DRAFT)
  sortOrder    Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  module    CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources LessonResource[]
  progress  LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  studentId   String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
  @@index([isCompleted])
}

model LessonResource {
  id             String         @id @default(cuid())
  lessonId       String
  name           String
  description    String?
  resourceType   ResourceType   @default(FILE)
  sourceType     ResourceSource @default(EXTERNAL)
  fileUrl        String
  fileType       String
  fileSize       Int?
  sortOrder      Int            @default(0)
  isDownloadable Boolean        @default(true)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([resourceType])
  @@index([sortOrder])
  @@index([isActive])
}

model ModuleSummary {
  id           String              @id @default(cuid())
  moduleId     String              @unique
  title        String
  description  String?
  content      String?
  resourceType LessonResourceType  @default(SLIDE)
  resourceUrl  String?
  duration     Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  module       CourseModule            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     ModuleSummaryProgress[]

  @@index([moduleId])
}

model ModuleSummaryProgress {
  id              String        @id @default(cuid())
  studentId       String
  moduleSummaryId String
  isCompleted     Boolean       @default(false)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  summary         ModuleSummary @relation(fields: [moduleSummaryId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleSummaryId])
  @@index([studentId])
  @@index([moduleSummaryId])
  @@index([isCompleted])
}

model ModuleQuiz {
  id               String       @id @default(cuid())
  moduleId         String       @unique
  title            String
  description      String?
  instructions     String?
  passingScore     Int          @default(70)
  maxAttempts      Int          @default(2)
  timeLimitMinutes Int?
  status           CourseStatus @default(DRAFT)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  module           CourseModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attempts         QuizAttempt[]

  @@index([moduleId])
}

model QuizAttempt {
  id            String     @id @default(cuid())
  quizId        String
  studentId     String
  attemptNumber Int        @default(1)
  score         Float      @default(0)
  passed        Boolean    @default(false)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())

  quiz          ModuleQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId, studentId])
}

model WeeklyAssignment {
  id                     String                 @id @default(cuid())
  weekId                 String                 @unique
  title                  String
  description            String
  instructions           String
  submissionType         String                 @default("FILE_OR_TEXT")
  submissionRequirements String?
  datasetUrl             String?
  datasetName            String?
  dueDateDays            Int?
  status                 CourseStatus           @default(DRAFT)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  week                   CourseWeek             @relation(fields: [weekId], references: [id], onDelete: Cascade)
  submissions            AssignmentSubmission[]

  @@index([weekId])
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  fileUrl      String?
  status       String           @default("SUBMITTED")
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment   WeeklyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
  @@index([assignmentId])
  @@index([studentId])
}
